---
interface Props {
  variant?: 'neutral' | 'accent' | undefined;
  mono?: boolean | undefined;
}

const { variant = 'neutral', mono = false } = Astro.props;

const variantClasses =
  variant === 'accent'
    ? 'bg-accent-subtle text-accent border-accent-border'
    : 'bg-surface-subtle text-ink-secondary border-border-hairline';
---

<span
  class:list={[
    'inline-flex items-center px-2 py-0.5 text-xs font-medium border rounded-sm leading-tight',
    mono && 'font-mono tracking-wide',
    variantClasses,
  ]}
>
  <slot />
</span>
