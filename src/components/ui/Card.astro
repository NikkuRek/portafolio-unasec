---
interface Props {
  as?: 'article' | 'section' | 'div' | undefined;
  class?: string | undefined;
}

const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag
  class:list={[
    'bg-surface border border-border-hairline rounded-md p-5 md:p-6',
    className,
  ]}
>
  <slot />
</Tag>
