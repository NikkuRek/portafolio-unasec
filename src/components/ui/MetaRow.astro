---
interface Props {
  label: string;
  value: string;
  mono?: boolean | undefined;
}

const { label, value, mono = false } = Astro.props;
---

<div class="flex flex-col gap-1 py-2.5 border-b border-border-hairline last:border-b-0">
  <dt class="text-xs text-ink-muted leading-snug">{label}</dt>
  <dd class:list={['text-sm font-medium text-ink-primary break-words leading-snug', mono && 'font-mono text-xs']}>
    {value}
  </dd>
</div>
