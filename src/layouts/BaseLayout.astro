---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { AUTHOR_PROFILE } from '../data/portfolio';

interface Props {
  title: string;
  description?: string | undefined;
}

const {
  title,
  description = `Portafolio académico del ${AUTHOR_PROFILE.course.name} (${AUTHOR_PROFILE.course.code}, ${AUTHOR_PROFILE.course.term}) — ${AUTHOR_PROFILE.fullName}, ${AUTHOR_PROFILE.university.name}.`,
} = Astro.props;

const fullTitle = `${title} | ${AUTHOR_PROFILE.fullName}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR_PROFILE.fullName} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <title>{fullTitle}</title>
    <script is:inline>
      try {
        if (localStorage.getItem('una-reading-mode') === 'on') {
          document.documentElement.setAttribute('data-reading-mode', 'on');
        }
      } catch {}
    </script>
  </head>
  <body class="flex flex-col min-h-dvh bg-canvas text-ink-primary">
    <a
      href="#contenido-principal"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-surface focus:rounded-md focus:text-sm focus:font-medium focus:no-underline"
    >
      Saltar al contenido principal
    </a>

    <Header currentPath={Astro.url.pathname} />

    <main id="contenido-principal" class="flex-1 min-w-0 w-full max-w-site mx-auto px-4 md:px-8 py-10 md:py-14">
      <slot />
    </main>

    <Footer />
  </body>
</html>
